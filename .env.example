# Copy to .env for local/dev runs of the python/ layer (python/config.py
# loads this automatically via python-dotenv). In production, n8n's Execute
# Command nodes need these set in the environment n8n itself runs in
# instead — see README.md "n8n setup" step 3.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# "gemini" (primary) or "groq" (fallback) — python/ai_client.py tries the
# configured provider first, then falls back to the other automatically.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# Optional. Per-company page-fetch ceiling for the research engine
# (docs/07-research-engine.md §7). Defaults to 6 if unset.
RESEARCH_MAX_FETCHES_PER_COMPANY=6
